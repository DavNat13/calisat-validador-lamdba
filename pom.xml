<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.lambda</groupId>
	<artifactId>validador</artifactId>
	<version>1.0.0</version>
	<name>validador</name>
	<description>Lambda authorizer JWT dual (Microsoft Entra ID + AWS Cognito) para API Gateway HTTP API</description>

	<properties>
		<java.version>21</java.version>
		<spring-cloud-function.version>5.0.4</spring-cloud-function.version>
		<aws-lambda-java-events.version>3.16.1</aws-lambda-java-events.version>
		<aws-lambda-java-serialization.version>1.4.1</aws-lambda-java-serialization.version>
		<aws-lambda-java-core.version>1.2.3</aws-lambda-java-core.version>
		<!-- Spring Boot 4.1 ya no gestiona nimbus-jose-jwt, pero Spring Security lo
		     espera en 10.9.1: subirlo por debajo romperia la validacion de firma. -->
		<nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>
		<!-- Spring Cloud Function localiza la aplicacion por el atributo Start-Class
		     del manifiesto; el parent lo usa como Main-Class del JAR. -->
		<start-class>org.springframework.cloud.function.adapter.aws.FunctionInvoker</start-class>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-function-dependencies</artifactId>
				<version>${spring-cloud-function.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Sin spring-boot-starter-web: la Lambda no debe levantar un servidor. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-function-context</artifactId>
		</dependency>
		<!-- El adaptador arrastra webflux y netty, que este authorizer no usa. No se
		     excluye el starter entero porque sus beans @ConditionalOnClass dejarian el
		     contexto a medio configurar: se quitan solo los binarios nativos de Netty. -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-function-adapter-aws</artifactId>
			<exclusions>
				<exclusion><groupId>io.netty</groupId><artifactId>netty-codec-native-quic</artifactId></exclusion>
				<exclusion><groupId>io.netty</groupId><artifactId>netty-transport-native-epoll</artifactId></exclusion>
				<exclusion><groupId>io.netty</groupId><artifactId>netty-transport-classes-epoll</artifactId></exclusion>
				<exclusion><groupId>io.netty</groupId><artifactId>netty-resolver-dns-native-macos</artifactId></exclusion>
				<exclusion><groupId>io.netty</groupId><artifactId>netty-resolver-dns-classes-macos</artifactId></exclusion>
			</exclusions>
		</dependency>

		<!-- Validacion de JWT (JwtDecoder, NimbusJwtDecoder, validators) sin arrastrar
		     todo Spring Security. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-jose</artifactId>
		</dependency>
		<dependency>
			<groupId>com.nimbusds</groupId>
			<artifactId>nimbus-jose-jwt</artifactId>
			<version>${nimbus-jose-jwt.version}</version>
		</dependency>

		<!-- ESTAS TRES NO SE TRATAN IGUAL. core y serialization van en "provided":
		     el runtime de Lambda ya las carga desde /var/runtime/lib; empaquetarlas
		     duplica RequestStreamHandler (/var/task se antepone) y el runtime deja de
		     invocar el handler (401 sin logs). events va en "compile": el runtime NO
		     proporciona APIGatewayV2CustomAuthorizerEvent. -->
		<dependency>
			<groupId>com.amazonaws</groupId>
			<artifactId>aws-lambda-java-core</artifactId>
			<version>${aws-lambda-java-core.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.amazonaws</groupId>
			<artifactId>aws-lambda-java-events</artifactId>
			<version>${aws-lambda-java-events.version}</version>
		</dependency>
		<dependency>
			<groupId>com.amazonaws</groupId>
			<artifactId>aws-lambda-java-serialization</artifactId>
			<version>${aws-lambda-java-serialization.version}</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>${project.artifactId}</finalName>
		<plugins>
			<!-- Start-Class en el manifiesto: lo arrastra el shade desde el JAR original. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifestEntries><Start-Class>com.lambda.validador.ValidadorApplication</Start-Class></manifestEntries>
					</archive>
				</configuration>
			</plugin>

			<!-- Sombreado con clases en la raiz, que es el layout que entiende el
			     runtime java21 gestionado. NO se declara spring-boot-maven-plugin: su
			     goal "repackage" anida las dependencias en BOOT-INF/lib y el runtime no
			     lee ese formato. outputFile da nombre fijo (target/function.jar) para
			     no tocar el CodeUri del template en cada cambio de version. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<configuration>
					<createDependencyReducedPom>false</createDependencyReducedPom>
					<outputFile>${project.build.directory}/function.jar</outputFile>
				</configuration>
				<executions>
					<execution>
						<id>default</id>
						<goals><goal>shade</goal></goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
